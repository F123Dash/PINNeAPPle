  },
  {
   "source": "geo",
   "source_port": "geometry",
   "target": "eq",
   "target_port": "geometry",
   "id": "geo.geometry->eq.geometry"
  },
  {
   "source": "mesh",
   "source_port": "mesh",
   "target": "eq",
   "target_port": "mesh",
   "id": "mesh.mesh->eq.mesh"
  },
  {
   "source": "eq",
   "source_port": "problem",
   "target": "sweep",
   "target_port": "problem",
   "id": "eq.problem->sweep.problem"
  },
  {
   "source": "sweep",
   "source_port": "data",
   "target": "hpo",
   "target_port": "data",
   "id": "sweep.data->hpo.data"
