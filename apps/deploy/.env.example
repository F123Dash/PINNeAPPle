# Public names (each needs a DNS A record -> this server's IPv4)
HSS_DOMAIN=heatsink.pinneapple.org
PCB_DOMAIN=pcb.pinneapple.org
EDH_DOMAIN=datahealth.pinneapple.org
EDS_DOMAIN=standardizer.pinneapple.org
SMD_DOMAIN=simmeta.pinneapple.org
UDR_DOMAIN=udr.pinneapple.org
IHL_DOMAIN=inverse.pinneapple.org
PFL_DOMAIN=preflight.pinneapple.org
MQA_DOMAIN=mesh.pinneapple.org
CMP_DOMAIN=compare.pinneapple.org
LIN_DOMAIN=lineage.pinneapple.org
IOP_DOMAIN=interop.pinneapple.org
ADO_DOMAIN=aero.pinneapple.org
LAB_DOMAIN=lab.pinneapple.org
OBS_DOMAIN=sky.pinneapple.org
PLG_DOMAIN=playground.pinneapple.org
RUNNER_DOMAIN=runner.pinneapple.org
CAMPAIGN_DOMAIN=campaign.pinneapple.org
UQL_DOMAIN=uncertainty.pinneapple.org
SEN_DOMAIN=sensitivity.pinneapple.org
VAL_DOMAIN=validate.pinneapple.org
EVR_DOMAIN=evidence.pinneapple.org
CALIB_DOMAIN=calibration.pinneapple.org
IDENT_DOMAIN=identifiability.pinneapple.org
INVS_DOMAIN=inverse-studio.pinneapple.org
GUIAGENT_DOMAIN=guiagent.pinneapple.org
ROM_DOMAIN=rom.pinneapple.org
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=yan@pinneapple.org

# Optional login per app (HTTP Basic). Leave both empty for open access.
HSS_USER=demo
HSS_PASSWORD=change-me
PCB_USER=demo
PCB_PASSWORD=change-me
EDH_USER=demo
EDH_PASSWORD=change-me
EDS_USER=demo
EDS_PASSWORD=change-me
SMD_USER=demo
SMD_PASSWORD=change-me
UDR_USER=demo
UDR_PASSWORD=change-me
IHL_USER=demo
IHL_PASSWORD=change-me
PFL_USER=demo
PFL_PASSWORD=change-me
MQA_USER=demo
MQA_PASSWORD=change-me
CMP_USER=demo
CMP_PASSWORD=change-me
LIN_USER=demo
LIN_PASSWORD=change-me
IOP_USER=demo
IOP_PASSWORD=change-me
ADO_USER=demo
ADO_PASSWORD=change-me
# PINNeAPPle Lab catalogue: leave both empty for a public catalogue
LAB_USER=
LAB_PASSWORD=
OBS_USER=
OBS_PASSWORD=
CALIB_USER=demo
CALIB_PASSWORD=change-me
IDENT_USER=demo
IDENT_PASSWORD=change-me
INVS_USER=demo
INVS_PASSWORD=change-me
# Day 13+ apps: login optional; X-API-Key works alongside it (apps/_shared/README.md)
CAMPAIGN_USER=
CAMPAIGN_PASSWORD=
UQL_USER=demo
UQL_PASSWORD=change-me
SEN_USER=demo
SEN_PASSWORD=change-me
VAL_USER=demo
VAL_PASSWORD=change-me
EVR_USER=demo
EVR_PASSWORD=change-me
# Engineering GUI Agent (optional heavy image)
GUIAGENT_USER=demo
GUIAGENT_PASSWORD=change-me
ROM_USER=demo
ROM_PASSWORD=change-me

# Concurrent heavy runs per worker (extra requests get HTTP 429)
HSS_MAX_SIZING=2
PCB_MAX_HEAVY=2
EDH_MAX_HEAVY=2
EDS_MAX_HEAVY=2
SMD_MAX_HEAVY=2
UDR_MAX_HEAVY=2
# Inverse Heat Lab: trainings at the same time (one worker; each takes a CPU core for 20 s to 2 min)
IHL_MAX_JOBS=2
PFL_MAX_HEAVY=2
MQA_MAX_HEAVY=2
CMP_MAX_HEAVY=2
LIN_MAX_HEAVY=2
IOP_MAX_HEAVY=2
ADO_MAX_HEAVY=2
# Day 13+ apps: jobs running at once (job queue shared by the workers; the rest wait in the queue)
CAMPAIGN_MAX_JOBS=2
UQL_MAX_HEAVY=2
SEN_MAX_HEAVY=2
VAL_MAX_HEAVY=2
EVR_MAX_HEAVY=2

# Reduced Order Model Lab: studies at once (shared job queue), largest upload, neural budget cap, key admin token,
# free use per caller and month (empty = defaults 30 studies, 100 exports, 20,000 queries; 'unlimited' lifts it)
ROM_MAX_JOBS=2
ROM_MAX_MB=200
ROM_MAX_BUDGET_S=30
ROM_ADMIN_TOKEN=
ROM_FREE_STUDIES=
ROM_FREE_EXPORTS=
ROM_FREE_QUERIES=

# Memory cap per app container (2 uvicorn workers each)
HSS_MEM_LIMIT=2g
PCB_MEM_LIMIT=2g
EDH_MEM_LIMIT=2g
EDS_MEM_LIMIT=2g
SMD_MEM_LIMIT=2g
UDR_MEM_LIMIT=2g
IHL_MEM_LIMIT=2g
PFL_MEM_LIMIT=2g
MQA_MEM_LIMIT=3g
CMP_MEM_LIMIT=3g
LIN_MEM_LIMIT=2g
IOP_MEM_LIMIT=3g
ADO_MEM_LIMIT=2g
LAB_MEM_LIMIT=1g
OBS_MEM_LIMIT=1500m
CAMPAIGN_MEM_LIMIT=1g
UQL_MEM_LIMIT=1g
SEN_MEM_LIMIT=1g
VAL_MEM_LIMIT=1g
EVR_MEM_LIMIT=1g
GUIAGENT_MEM_LIMIT=2g
ROM_MEM_LIMIT=1g

# Form Compiler: your copy of the fillable Form U-DR-1, put in apps/deploy/forms/ (optional; users can upload it)
UDR_FORM_PDF=/forms/u-dr-1.pdf
# Optional local LLM (Ollama) for free-form documents; empty model = rule-based reader only.
# Default URL is the `ollama` service (--profile llm); for Ollama on the host use http://host.docker.internal:11434
UDR_OLLAMA_URL=http://ollama:11434
UDR_OLLAMA_MODEL=
UDR_OLLAMA_TIMEOUT=600

# Simulation Workflow Runner (day 27). Public demo: built-in templates only. Free use per principal and month.
RUNNER_USER=
RUNNER_PASSWORD=
RUNNER_ADMIN_TOKEN=
RUNNER_MAX_JOBS=2
RUNNER_MAX_CASES=60
RUNNER_FREE_JOBS_RUN=200
RUNNER_FREE_COMPUTE_SECONDS=3600
RUNNER_FREE_STORAGE_MB=500
RUNNER_MEM_LIMIT=1g
# Day 13+ apps: monthly free use per API key / login / IP (empty = app default, "unlimited" lifts it),
# and the token that manages API keys when the app has no login (X-Admin-Token)
CAMPAIGN_FREE_CAMPAIGNS=
CAMPAIGN_FREE_CASES_PLANNED=
CAMPAIGN_ADMIN_TOKEN=


# Engineering Uncertainty Lab: study size limits
UQL_MAX_CASES=2000
UQL_MAX_PROPAGATION=20000
UQL_MAX_HF=40
UQL_MAX_MB=50


# Engineering Sensitivity Lab: study size limits
SEN_MAX_EVALS=400000
SEN_MAX_PARAMS=30
SEN_MAX_MB=50

# Model Calibration Lab: analyses at once (job queue, over all workers), admin token for API keys, free use per caller and month
CALIB_MAX_JOBS=2
CALIB_ADMIN_TOKEN=
CALIB_FREE_CALIBRATIONS=50
CALIB_FREE_METHOD_RUNS=200
CALIB_FREE_PINN_RUNS=10
CALIB_MEM_LIMIT=1g

# Parameter Identifiability Lab: analyses at once (job queue, over all workers), admin token for API keys, free use per caller and month
IDENT_MAX_JOBS=2
IDENT_ADMIN_TOKEN=
IDENT_FREE_ANALYSES=100
IDENT_FREE_PARAMETERS=600
IDENT_FREE_SCENARIOS=5000
IDENT_MEM_LIMIT=1g

# Inverse Model Studio: analyses at once (job queue, over all workers), admin token for API keys, free use per caller and month
INVS_MAX_JOBS=2
INVS_ADMIN_TOKEN=
INVS_FREE_PROBLEMS=50
INVS_FREE_METHOD_RUNS=250
INVS_FREE_PINN_RUNS=10
INVS_MEM_LIMIT=1g

# Engineering GUI Agent: public = only the committed workflows run (the demo); selfhosted = POST /api/workflows
# adds your own workflows, projects and macros (macros are code: never on a public server)
GUIAGENT_MODE=public
GUIAGENT_MAX_JOBS=1
GUIAGENT_ADMIN_TOKEN=
# free use per caller and month (empty = defaults: 20 runs, 1800 compute seconds, 500 MB; 'unlimited' lifts it)
GUIAGENT_FREE_RUNS=
GUIAGENT_FREE_COMPUTE_SECONDS=
GUIAGENT_FREE_STORAGE_MB=
GUIAGENT_KEEP_RUNS=40
# Optional: read free-form tasks with a local LLM (the `ollama` service, --profile llm); empty = rule-based
GUIAGENT_OLLAMA_URL=http://ollama:11434
GUIAGENT_OLLAMA_MODEL=
